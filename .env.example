# String de conexão do Postgres do Supabase (Project Settings > Database > Connection string > URI).
# Use a "Connection pooling" (porta 6543) em produção/Vercel.
DATABASE_URL="postgresql://postgres:[SUA-SENHA]@[SEU-PROJETO].supabase.co:5432/postgres"

# Senha única compartilhada pra acessar o app (trava simples via middleware).
APP_PASSWORD=
